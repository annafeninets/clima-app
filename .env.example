# --- PostgreSQL (обязательно) ---
# Пароль генерирует `make secrets`. Только символы A-Za-z0-9-_ — он подставляется в URL подключения.
POSTGRES_DB=clima
POSTGRES_USER=clima
POSTGRES_PASSWORD=
# Нужен только для запуска backend вне compose (uv run clima); в compose адрес собирается сам.
# CLIMA_DATABASE_URL=postgresql://clima:ПАРОЛЬ@127.0.0.1:5432/clima
# Максимум соединений в пуле backend → PostgreSQL.
CLIMA_DB_POOL_MAX=10

# --- Redis (необязательно: кеш погоды и отметки утренней рассылки) ---
# В compose включён по умолчанию (redis://redis:6379/0). Пустое значение = кеш в памяти процесса.
# CLIMA_REDIS_URL=redis://127.0.0.1:6379/0

# --- backend ---
CLIMA_LOG_LEVEL=INFO
# Нужен только если frontend открывается с другого origin, чем API (при запуске через compose не нужен).
CLIMA_CORS_ORIGINS=http://localhost:8080
# Секреты генерирует `make secrets` (scripts/gen_secrets.py) — не коммитьте заполненный .env.
# Ручная генерация VAPID-пары: `npx --yes web-push generate-vapid-keys`; приватный ключ только для backend.
CLIMA_VAPID_PRIVATE_KEY=
CLIMA_VAPID_SUBJECT=mailto:you@example.com
CLIMA_SCHEDULER_TOKEN=
# Ключ OpenWeather (https://home.openweathermap.org/api_keys). Без него прогноз берётся из Open-Meteo.
# Новый ключ активируется не мгновенно (до пары часов): до этого OpenWeather отвечает 401, и Clima молча использует Open-Meteo.
CLIMA_OPENWEATHER_API_KEY=

# --- frontend (публичные значения) ---
CLIMA_VAPID_PUBLIC_KEY=
CLIMA_PUBLIC_API_URL=/api

# --- docker compose ---
CLIMA_WEB_BIND=127.0.0.1
CLIMA_WEB_PORT=8080
